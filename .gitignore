node_modules
dist
.env
.env.local
.env.*.local
.env.prod
.DS_Store
*.log
# Self-hosted local ML model weights (lazy-fetched on tool interaction, browser-cached).
# Kept out of git history — fetched into place by scripts/fetch-local-models, or via the
# remote (HuggingFace) fallback on networks that can reach it. See apps/web/src/tools/local-sam.ts.
apps/web/public/models/*
apps/api/storage/uploads/*
apps/api/storage/previews/*
apps/api/storage/finals/*
apps/api/storage/derived/*
!apps/api/storage/uploads/.gitkeep
!apps/api/storage/previews/.gitkeep
!apps/api/storage/finals/.gitkeep
!apps/api/storage/derived/.gitkeep

# A repo-root-relative path used while the shell is already inside the package. A probe that writes to
# `path.join(process.cwd(), "apps/worker/tmp/...")` from apps/worker lands here instead, and because
# apps/worker/tmp is untracked-but-not-ignored, a broad `git add` then commits the artifacts (that is
# how 11 screenshots got committed here in 62cd9ba). Once tracked they come back on every checkout and
# look exactly like junk, so they have twice been deleted by someone tidying up.
#
# The doubled path can only ever be a mistake, so the rule is cheaper than care: it is ignored, and the
# files that were tracked under it have been removed (git history keeps them). Deliberately NOT
# extending this to `apps/worker/tmp/` itself — that would hide live probe scripts from `git status`,
# where other sessions are working.
apps/worker/apps/

# Across-commit baseline stills (render:baseline). The reviewable reference is the sha256 in
# tmp/render-baseline/baseline.json, which IS committed; the PNGs are ~70MB of local diagnosis.
tmp/render-baseline/*.png
tmp/render-baseline/current/
# Partners rendered only to evaluate a cross-fixture relation in a SCOPED run — never a reference.
tmp/render-baseline/relations/
