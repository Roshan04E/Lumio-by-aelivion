# NODE_ENV IS DELIBERATELY ABSENT AND MUST STAY THAT WAY.
#
# `apps/web/vite.config.ts` sets `envDir: repoRoot` so one env file serves web+api+worker. Vite reads
# this file during `vite build` and promotes NODE_ENV out of it into process.env whenever the shell has
# not already set it — which flips the build to `isProduction = false` and bundles
# react-dom.development.js into the shipped assets. That cost multi-second main-thread commit stalls
# and ~2 weeks of misdirected profiling (project-tracker/playback-preview.md v32).
#
# Nothing needs it here: the API defaults to "development" (apps/api/src/config/env.ts), the prisma and
# worker guards are `!== "production"`, and apps/{api,worker}/Dockerfile set it to "production" for
# deploys. The web build pins it itself via cross-env.
PORT=4100
# WEB_ORIGIN = the browser origin allowed by CORS + the OAuth/redirect origin. API_PUBLIC_URL = the
# public base the API is reached at (also baked into stored media URLs). In production set BOTH to your
# real https domains (e.g. WEB_ORIGIN=https://app.example.com, API_PUBLIC_URL=https://api.example.com),
# # keep VITE_API_URL below in sync (=$API_PUBLIC_URL/api). Set NODE_ENV=production in the deploy
# ENVIRONMENT (the Dockerfiles already do) — never in this file, see the header.
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4100
DATABASE_URL=postgresql://orreris:orreris@localhost:5432/orreris?schema=public
REDIS_URL=redis://localhost:6379
# Render dispatch. "mock" (default) = the worker POLLS Postgres every 2s for queued jobs — zero infra,
# fine for a single local worker. "bullmq" = the API pushes each render job onto Redis/BullMQ so a
# fleet of worker replicas can consume it. This MUST be set to the SAME value on BOTH the api and the
# worker process, and Redis (REDIS_URL) must be reachable. Use "bullmq" in cloud/multi-worker deploys.
WORKER_QUEUE=mock
JWT_SECRET=replace-this-with-a-long-random-secret
STORAGE_ROOT=apps/api/storage
# Object storage. Leave as "local" for dev (on-disk). Media is local-first in the browser either way;
# this only backs the opt-in "upload to cloud" path. For Cloudflare R2 set STORAGE_DRIVER=r2 and fill:
#   R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   (R2 → Overview → S3 API endpoint)
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY  (R2 → Manage R2 API Tokens → create Object-Read-&-Write token)
# R2_PUBLIC_BASE_URL is optional (an R2 public dev URL or custom domain); without it the API proxies
# BROWSER reads. The cloud render worker does NOT use the proxy: it rewrites source URLs to presigned
# R2 GET URLs and reads media directly from R2 (native Range), so cloud exports work with a fully
# PRIVATE bucket. Set R2_PUBLIC_BASE_URL only to also speed up the browser editor's media loads.
#
# REQUIRED for the direct-to-R2 upload path (opt-in "upload to cloud"): the browser PUTs bytes
# straight to the bucket via a presigned URL, so the bucket needs a CORS policy allowing PUT from
# the web origin. In Cloudflare dashboard → R2 → <bucket> → Settings → CORS Policy, add:
#   [{ "AllowedOrigins": ["http://localhost:5173", "https://your-prod-domain"],
#      "AllowedMethods": ["PUT"], "AllowedHeaders": ["content-type"], "MaxAgeSeconds": 3600 }]
# Without this the multipart fallback still works, but the fast browser→bucket upload is blocked by CORS.
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_BUCKET=orreris
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Cloud render worker (Remotion). The worker auto-detects an installed Chrome/Edge and uses it,
# so it normally never downloads the managed Chrome Headless Shell. Set this only to override the
# detected browser (or to point at one in a non-standard location), e.g.:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe  (or msedge.exe)
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
REMOTION_BROWSER_EXECUTABLE=
VITE_API_URL=http://localhost:4100/api
# Google Sign-In (optional). Create an OAuth 2.0 Client ID (type: Web application) in the
# Google Cloud console, add http://localhost:5173 as an authorized JavaScript origin, and put
# the SAME client id in both vars. The Google button only appears when VITE_GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GEMINI_API_KEY=GEMINI_API_KEY
# Stock media search (optional). Free API key: pexels.com/api. When absent, the unified Search tab
# shows an "unconfigured" state; imports always download the file into our own storage so the export
# worker can fetch it (no remote URLs on the timeline).
PEXELS_API_KEY=your_pexel_api
# AI asset generation — fal.ai aggregator (image + video). Held server-side; when absent, the
# Generate Studio only offers local image generation (a local Stable Diffusion / AUTOMATIC1111
# server). Generated media is downloaded into our own storage as a SourceAsset(source="ai").
FAL_KEY=your_fal_key
# Orreris AI — planner gateway (GP1). Add ANY of these free, no-card, OpenAI-compatible keys to
# enable the LLM planner; the gateway fails over Cerebras → Groq → OpenRouter → Gemini and falls
# back to the always-free deterministic planner if the pool is exhausted. Model IDs are overridable
# because free tiers drift — verify the current free model id at each provider.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_PLANNER_MODEL=gemini-2.5-flash
# Premium last-hop (GP4), opt-in. Not in the GP1 pool path yet.
ANTHROPIC_API_KEY=
ANTHROPIC_PLANNER_MODEL=claude-opus-4-8
# Set to "off" to force the deterministic planner even when a key is present.
VITE_ORRERIS_LLM_PLANNER=
# Set to 1 (or LOG_LEVEL=debug) to log every planner-gateway provider attempt/failure to the
# server console. Useful when the AI returns no plan — keys and full prompts are never logged.
ORRERIS_AI_DEBUG=
# Orreris AI — "Local" mode (Ollama). No server env needed: the browser talks DIRECTLY to the user's
# Ollama, so requests never leave their machine. Each user just runs Ollama allowing this web origin:
#   OLLAMA_ORIGINS=http://localhost:5173 ollama serve   (then `ollama pull <model>`, e.g. llama3.2-vision)
# and turns on the "Local" button next to "Pro" in the AI chat. No key/quota; vision models read images.
