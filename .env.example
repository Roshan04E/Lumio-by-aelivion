NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4100
DATABASE_URL=postgresql://lumio:lumio@localhost:5432/lumio?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-this-with-a-long-random-secret
STORAGE_ROOT=apps/api/storage
# Cloud render worker (Remotion). The worker auto-detects an installed Chrome/Edge and uses it,
# so it normally never downloads the managed Chrome Headless Shell. Set this only to override the
# detected browser (or to point at one in a non-standard location), e.g.:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe  (or msedge.exe)
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
REMOTION_BROWSER_EXECUTABLE=
VITE_API_URL=http://localhost:4100/api
# Google Sign-In (optional). Create an OAuth 2.0 Client ID (type: Web application) in the
# Google Cloud console, add http://localhost:5173 as an authorized JavaScript origin, and put
# the SAME client id in both vars. The Google button only appears when VITE_GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GEMINI_API_KEY=GEMINI_API_KEY
# Stock media providers (optional). Free API keys: pexels.com/api & pixabay.com/api/docs.
# When a key is absent the Stock tab shows an "add API key" state; imports always download the
# file into our own storage so the export worker can fetch it (no remote URLs on the timeline).
PEXELS_API_KEY=your_pexel_api
PIXABAY_API_KEY=your_pixabay_api
# AI asset generation — fal.ai aggregator (image + video). Held server-side; when absent, the
# Generate Studio only offers local image generation (a local Stable Diffusion / AUTOMATIC1111
# server). Generated media is downloaded into our own storage as a SourceAsset(source="ai").
FAL_KEY=your_fal_key
# Lumio AI — planner gateway (GP1). Add ANY of these free, no-card, OpenAI-compatible keys to
# enable the LLM planner; the gateway fails over Cerebras → Groq → OpenRouter → Gemini and falls
# back to the always-free deterministic planner if the pool is exhausted. Model IDs are overridable
# because free tiers drift — verify the current free model id at each provider.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_PLANNER_MODEL=gemini-2.5-flash
# Premium last-hop (GP4), opt-in. Not in the GP1 pool path yet.
ANTHROPIC_API_KEY=
ANTHROPIC_PLANNER_MODEL=claude-opus-4-8
# Set to "off" to force the deterministic planner even when a key is present.
VITE_LUMIO_LLM_PLANNER=
# Set to 1 (or LOG_LEVEL=debug) to log every planner-gateway provider attempt/failure to the
# server console. Useful when the AI returns no plan — keys and full prompts are never logged.
LUMIO_AI_DEBUG=
# Lumio AI — "Local" mode (Ollama). No server env needed: the browser talks DIRECTLY to the user's
# Ollama, so requests never leave their machine. Each user just runs Ollama allowing this web origin:
#   OLLAMA_ORIGINS=http://localhost:5173 ollama serve   (then `ollama pull <model>`, e.g. llama3.2-vision)
# and turns on the "Local" button next to "Pro" in the AI chat. No key/quota; vision models read images.
