# Orreris PRODUCTION env — copy to .env.prod (gitignored) and fill in the CHANGE_ME values.
# Consumed by docker-compose.prod.yml via env_file (injected into api / worker / migrate / postgres).
# Hostnames use the compose SERVICE names (postgres, redis) — not localhost.
#
# NOTE: VITE_* values are BUILD-time (baked into the web bundle) and live in the compose `web.build.args`,
# NOT here. Optional integration keys (Google, Gemini, Pexels, fal, AI planner providers) are omitted for
# brevity — copy any you use from .env.example; each feature stays off until its key is present.

NODE_ENV=production
PORT=4100

# Public origins. Single-host: both are your one public domain (the web nginx proxies /api and /storage
# to the API). API_PUBLIC_URL is also baked into stored media URLs, so it MUST be the public URL the
# browser can reach — https, no trailing slash.
WEB_ORIGIN=https://your-domain.example
API_PUBLIC_URL=https://your-domain.example

# Postgres. The POSTGRES_* trio initializes the bundled postgres container; DATABASE_URL must use the
# SAME user/password/db and the `postgres` service host. For MANAGED Postgres, point DATABASE_URL at the
# managed host (add ?sslmode=require) and you can drop the POSTGRES_* trio + the postgres service.
POSTGRES_USER=orreris
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=orreris
DATABASE_URL=postgresql://orreris:CHANGE_ME_strong_db_password@postgres:5432/orreris?schema=public

# Redis + render dispatch. bullmq = the API pushes jobs to Redis for the worker fleet (production).
REDIS_URL=redis://redis:6379
WORKER_QUEUE=bullmq

# Auth. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=CHANGE_ME_long_random_secret_min_16_chars

# Object storage. Production uses Cloudflare R2 (S3-compatible). The render worker reads media by
# localizing it over presigned GETs (works with a PRIVATE bucket); R2_PUBLIC_BASE_URL is optional and
# only speeds up the browser editor's media loads. See .env.example for the R2 token + CORS setup notes.
STORAGE_DRIVER=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_PUBLIC_BASE_URL=
